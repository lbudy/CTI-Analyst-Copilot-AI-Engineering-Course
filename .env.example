# Copy this file to .env and fill in your API key.
# .env is gitignored so your keys stay out of the repo.

OPENAI_API_KEY=your-openai-key-here

# Logfire project write token; never commit real credentials.
LOGFIRE_TOKEN=
# Capture full prompts, report passages, tool arguments/results and answers:
LOGFIRE_INCLUDE_CONTENT=false
# For EU projects, use the endpoint shown by your Logfire project setup:
# LOGFIRE_BASE_URL=https://logfire-eu.pydantic.dev
# Optional separate read token for SQL downloads:
LOGFIRE_READ_TOKEN=
